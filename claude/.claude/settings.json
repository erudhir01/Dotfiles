{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)"
    ]
  },
  "model": "sonnet",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "topic-colors@my-mods": true,
    "status-band@my-mods": true
  },
  "extraKnownMarketplaces": {
    "my-mods": {
      "source": {
        "source": "directory",
        "path": "/home/erudhir/.claude/my-mods"
      }
    }
  },
  "theme": "dark"
}
